# ── Secrets and crypto material ──────────────────────────────────────────────
# ASP.NET Data Protection keys (crypto material — never commit)
TFE.Api/DataProtection-Keys/
# Azure publish profiles carry deployment credentials in clear text
*.PublishSettings
*.pubxml.user
appsettings.Local.json

# ── .NET build output ────────────────────────────────────────────────────────
# Regenerated by `dotnet restore` / `dotnet build`. Tracking them was actively harmful: the committed
# project.assets.json and *.nuget.g.props hold absolute paths from one developer's machine, which are
# meaningless on any other machine and on a CI runner.
[Bb]in/
[Oo]bj/

# Local publish output — the CI pipeline builds its own from source
publish/

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vs/
.idea/
*.user
.DS_Store
Thumbs.db
