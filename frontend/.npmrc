# Turns the `engines` range in package.json into a hard failure instead of a warning: an
# incompatible Node version is refused at `npm install` rather than surfacing later as an opaque
# build error. Vite 8 requires ^20.19.0 || >=22.12.0 — Node 20.9 or 22.0 install fine and then
# break at build time, which is the failure this prevents.
engine-strict=true
