{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-psychology-tfe-cqfrh8a6dbf4b2fu.belgiumcentral-01.azurewebsites.net/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://api-psychology-tfe-cqfrh8a6dbf4b2fu.belgiumcentral-01.azurewebsites.net/hubs/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api-psychology-tfe-cqfrh8a6dbf4b2fu.belgiumcentral-01.azurewebsites.net/health"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/hubs/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
